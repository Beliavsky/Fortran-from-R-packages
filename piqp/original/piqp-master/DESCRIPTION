Package: piqp
Title: R Interface to Proximal Interior Point Quadratic Programming
        Solver
Version: 0.6.2
Authors@R: c(person("Balasubramanian", "Narasimhan", role=c("aut", "cre"),
	   	   email = "naras@stanford.edu"),
             person("Roland", "Schwan", role = c("aut", "cph")),
