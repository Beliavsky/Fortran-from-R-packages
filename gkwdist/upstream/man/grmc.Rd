plot(ellipse_gd[, 1], ellipse_gd[, 2],
  type = "l", lwd = 2, col = "#2E4057",
  xlab = expression(gamma), ylab = expression(delta),
  main = "Gamma vs Delta", las = 1, xlim = range(ellipse_gd[, 1], ci_gamma_gd),
  ylim = range(ellipse_gd[, 2], ci_delta_gd)
